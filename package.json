{
  "name": "pjsk-scenario-player",
  "version": "0.2.1",
  "description": "Browser replica of Project SEKAI's story player: plays ScenarioSceneData with Live2D, as an embeddable library.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Team-Haruki/sekai-scenario-player.git"
  },
  "keywords": [
    "project-sekai",
    "pjsk",
    "live2d",
    "pixi",
    "scenario",
    "visual-novel"
  ],
  "type": "module",
  "private": true,
  "main": "./dist/lib/pjsk-scenario-player.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/pjsk-scenario-player.js"
    },
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "dist/lib",
    "src",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "npm run build:lib && npm run build:web",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:web": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json && vue-tsc --noEmit -p web/tsconfig.json",
    "serve:assets": "node server/cli.ts",
    "prepare": "npm run build:lib"
  },
  "peerDependencies": {
    "pixi.js": "^7.4.3"
  },
  "dependencies": {
    "@pixi/assets": "^7.4.3",
    "@sekai-world/pixi-live2d-display-mulmotion": "^0.5.1",
    "pixi.js": "^7.4.3"
  },
  "devDependencies": {
    "@lucide/vue": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vue": "^3.5.44",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.3.13"
  }
}
